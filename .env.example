# Copy to .env for local development only. In production these are Netlify environment variables
# (docs/DEPLOY.md lists scopes and contexts). Never commit real values.
# Production uses Netlify Database (NETLIFY_DB_URL, set by Netlify); DATABASE_URL is for local runs.

NODE_ENV=development
DATABASE_URL=postgres://postgres@127.0.0.1:5432/hackattack
PUBLIC_SITE_URL=http://localhost:8888
PUBLIC_API_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8888

# openssl rand -base64 32
TOKEN_SIGNING_KEY=
SECRET_ENCRYPTION_KEY=
# name:sha256hex(token)   e.g. printf %s "$TOKEN" | sha256sum
ADMIN_TOKENS=

TURNSTILE_SECRET_KEY=
TURNSTILE_BYPASS=true          # development only; rejected in production

# CASL sender identification (required when email is live in production)
SENDER_NAME=HACK-ATTACK (Spin State Labs)
SENDER_POSTAL_ADDRESS=
SENDER_CONTACT_EMAIL=
EMAIL_FROM=
SMTP_URL=
DIGEST_HOUR_UTC=13

# Per channel: CHANNEL_<NAME>_ENABLED, CHANNEL_<NAME>_MODE (auto|assisted|manual-queue), CHANNEL_<NAME>_DRY_RUN
# Names: EMAIL WEBHOOK RSS TELEGRAM BLUESKY MASTODON X LINKEDIN SUBSTACK WHATSAPP TRUTHSOCIAL
# Dry-run defaults to true for every channel.
CHANNEL_EMAIL_DRY_RUN=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=
NETLIFY_BUILD_HOOK_URL=

# X: off unless X_ENABLED=true. Verify current pricing, then set X_PRICING_VERIFIED_ON=YYYY-MM-DD.
X_ENABLED=false
X_MONTHLY_CAP_USD=10
X_PRICE_PER_POST_USD=0.015
X_PRICE_PER_POST_WITH_URL_USD=0.20
X_PRICING_VERIFIED_ON=
X_INCLUDE_URL=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_DISABLE_AFTER_FAILURES=5
